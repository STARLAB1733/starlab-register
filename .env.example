# Upstash Redis — auto-added when you connect an Upstash database via
# Vercel dashboard → Storage → Marketplace Database Providers → Upstash
# (prefixed "UPSTASH_REDIS" to avoid clashing with old REDIS_URL)
UPSTASH_REDIS_KV_REST_API_URL=https://your-db.upstash.io
UPSTASH_REDIS_KV_REST_API_TOKEN=your-token-here

# S1 admin passphrase — set in Vercel project settings, share with S1 only
ADMIN_PASSWORD=change-me-to-a-strong-passphrase
